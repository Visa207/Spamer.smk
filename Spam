
<script>
(() => {
  let ctx = null;
  let oscillators = [];
  let stopTimer = null;

  function stopSound() {
    if (stopTimer !== null) {
      clearTimeout(stopTimer);
      stopTimer = null;
    }

    if (ctx) {
      ctx.close().catch(() => {});
      ctx = null;
    }

    oscillators = [];
  }

  function tone(context, freq, at, length, peak) {
    const osc = context.createOscillator();
    const gain = context.createGain();

    osc.type = 'square';
    osc.frequency.setValueAtTime(freq, at);
    gain.gain.setValueAtTime(0.0001, at);
    gain.gain.exponentialRampToValueAtTime(peak, at + 0.015);
    gain.gain.setValueAtTime(
      peak,
      at + Math.max(0.02, length - 0.05)
    );
    gain.gain.exponentialRampToValueAtTime(
      0.0001,
      at + length
    );

    osc.connect(gain);
    gain.connect(context.destination);
    osc.start(at);
    osc.stop(at + length + 0.02);

    oscillators.push(osc);
  }

  async function start() {
    stopSound();

    document.getElementById('promo').style.display = 'none';
    document.getElementById('result').style.display = 'block';

    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) throw new Error('Web Audio API недоступний');

      ctx = new AC();
      await ctx.resume();

      const baseSeq = [
        [740, 0.20], [988, 0.20], [740, 0.20],
        [1175, 0.28], [587, 0.18], [880, 0.24],
        [1175, 0.32], [740, 0.22]
      ];

      let t = ctx.currentTime + 0.05;

      // Повтори з розрахунком на 5 хвилин
      const duration = 300;
      const sequenceDuration =
        baseSeq.reduce((sum, item) => sum + item[1] + 0.045, 0) + 0.01;
      const repeats = Math.ceil(duration / sequenceDuration);

      for (let i = 0; i < repeats; i++) {
        for (const [freq, length] of baseSeq) {
          tone(ctx, freq, t, length, 0.12);
          t += length + 0.045;
        }
        t += 0.01;
      }

      stopTimer = setTimeout(stopSound, 300000);
    } catch (e) {
      console.error('Помилка запуску звуку:', e);
      stopSound();
    }
  }

  document.getElementById('open').addEventListener('click', start);
  document.getElementById('skip').addEventListener('click', start);
})();
</script>
